# 复制为 .env 后填写。所有 Key 均可留空，留空时系统进入“演示模式”。
# 演示模式使用内置示例地点库、示例攻略与历史气候参考，不会伪装成实时查询结果。

# ---------- 可选：OpenAI 兼容大模型 ----------
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60

# ---------- 可选：高德地图 Web 服务 ----------
# 配置后，内置示例库未覆盖的城市会尝试实时 POI 检索；
# 实时 POI 只能核验名称/地址/坐标，无法核验营业时间和票价。
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=15

# ---------- 可选：和风天气 ----------
# 配置后，行程日期在 3 天预报范围内会使用真实预报；否则仍使用历史气候参考。
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_TIMEOUT_SECONDS=15

# ---------- 本地配置 ----------
DATABASE_PATH=data/app.db
HOST=127.0.0.1
PORT=8000
